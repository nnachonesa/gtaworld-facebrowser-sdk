{
	"compilerOptions": {
		"module": "commonjs",
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"target": "es2019",
		"outDir": "./typings",
		"incremental": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"inlineSourceMap": true,
		"rootDir": "./src",
		"strictNullChecks": true
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"src",
		"src"
	]
}