{
	"scripts": {
		"lint": "biome lint ./src/",
		"lint:fix": "biome check --write ./src/",
		"format": "biome format --write ./src/",
		"check": "biome check ./src/",
		"build": "tsc",
		"prepublishOnly": "tsc"
	},
	"name": "gtaworld-fb",
	"version": "2.0.3",
	"description": "Una librería TypeScript para interactuar con la API de GTA World (es) de forma sencilla y tipada.",
	"keywords": [
		"rp",
		"roleplay",
		"gtaworld",
		"gtaworldes",
		"gta-world",
		"gta-world-es"
	],
	"license": "MIT",
	"author": "nnachonesa",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nnachonesa/gtaworld-facebrowser-sdk.git"
	},
	"bugs": {
		"url": "https://github.com/nnachonesa/gtaworld-facebrowser-sdk/issues"
	},
	"homepage": "https://github.com/nnachonesa/gtaworld-facebrowser-sdk#readme",
	"main": "./typings/index.js",
	"types": "./typings/index.d.ts",
	"exports": {
		".": {
			"types": "./typings/index.d.ts",
			"require": "./typings/index.js",
			"import": "./typings/index.js"
		}
	},
	"files": [
		"typings",
		"src",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"ky": "^2.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/bun": "latest",
		"typescript": "^5.7.0"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	}
}
